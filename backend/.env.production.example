# Production Environment Variables for Backend
NODE_ENV=production
PORT=3000

# PostgreSQL Connection String (Neon Cloud or local pooled database)
DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>/<DATABASE>?sslmode=require"

# JWT Authentication Secrets
JWT_SECRET="CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_STRING_AT_LEAST_64_CHARS"
JWT_EXPIRES_IN="7d"

# Allowed Frontend URL for CORS
FRONTEND_URL="https://reg.youruniversity.ac.th"
